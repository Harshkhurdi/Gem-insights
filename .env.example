DATABASE_URL=postgresql://gem:change_me@localhost:5432/gem_intelligence
TEST_DATABASE_URL=postgresql://gem:change_me@localhost:5432/gem_intelligence_test
DATABASE_SSL=false
API_HOST=127.0.0.1
PORT=4000
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
# At least 24 characters. Generate a private random secret; do not commit it.
ADMIN_KEY=
# Direct GeM scraping is disabled. Configure only an operator-authorized JSON feed.
AUTHORIZED_FEED_URL=
FEED_AUTHORIZED=false
SYNC_INTERVAL_MS=3600000
FEED_PAGE_DELAY_MS=5000

# API and worker must share this private filesystem location, outside the web root.
DOCUMENT_STORAGE_DIR=.runtime/documents
# Optional native OCR executable paths; install locally before enabling OCR.
PDFTOPPM_BIN=pdftoppm
TESSERACT_BIN=tesseract
OCR_LANGUAGES=eng

# Automatic public-listing discovery (AIIMS Raipur, ICMR, CPPP).
# Runs only while the local background worker is running. Per-source pauses
# and intervals are stored in PostgreSQL through Tender Collection.
COLLECTION_ENABLED=true
